# ==============================================================================
# Environment Configuration for Gemma 4 31B IT Multimodal Script Evaluation
# ==============================================================================

# 1. Hugging Face Access Token (REQUIRED for gated Gemma models)
# Get your token at: https://huggingface.co/settings/tokens
# Also accept model terms at: https://huggingface.co/google/gemma-4-31b-it
HF_TOKEN=your_huggingface_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# 2. Hugging Face Cache Location (Optional - set if you want weights stored on a specific disk)
# e.g., D:/hf_cache or D:/models/huggingface
# HF_HOME=D:/hf_cache

# 3. Model & Pipeline Defaults (Optional overrides)
DEFAULT_MODEL_ID=google/gemma-4-31b-it
DEFAULT_QUANTIZATION=4bit

# 4. Google Drive Source URLs
GDRIVE_BANGLA_URL=https://drive.google.com/drive/folders/1tUwj_h5fCMhzymloXhUEJqTeTFKD-ogS
GDRIVE_ENGLISH_URL=https://drive.google.com/drive/folders/11spWhJTncBfM_qsOvpH17AgduhyQpqSN
