+"""
+Learned per-question content model: which question a piece of answer text answers, learned from the other
+students' answers to the same paper.
+
+  - Every question of a paper has a multinomial model of the tokens of its answers (lowercased words, numbers and
+    single symbols such as '+', '|', ':', which carry layout: matching pairs, tables, dialogue turns), with add-one
+    smoothing. The training answers are the ones the segmenter files under a written header (header lines removed,
+    so the number in the header is not learned as content).
+  - Naive Bayes is far too confident on long texts, so its log-likelihoods are turned into probabilities with two
+    fitted numbers: P(q | text) = softmax(beta * n^(gamma - 1) * loglik_q), n the number of tokens.
+  - Some answers look like no other student's (a cloze passage copied out in full where others list the words): the
+    content then says nothing, which the model reads as a share lam of texts whose probabilities are uniform.
+  - A written header is right most of the time. The model reads the probability that a header names the wrong
+    question as eps(situation), for the situation the header is in: it names the next question ('next'), one further
+    on ('later'), an earlier question not yet answered ('back'), a question already answered ('answered'), or the
+    question being answered ('repeat'). A wrong header names any other question equally often.
+  - beta and gamma are fitted by maximum likelihood on header sections of scripts the token counts did not see
+    (5 folds by script), with lam and eps per situation fitted by expectation-maximisation. lam and eps can be told
+    apart because lam is the same in every situation and eps is not. Nothing is set by hand.
+
+The segmenter uses it to decide whether the content below a header overrules the header: the question with the
+highest probability given both the header and the content wins. With the fitted numbers, content can only overrule
+a header in situations where a wrong header is more likely than content that says nothing (eps / (1 - eps) > lam
+roughly).
+Train it with scripts/train_content_model.py; the model is stored in configs/segmenter/content_model.json.
+"""
+
+import json
+import math
+import re
+from pathlib import Path
+from typing import Dict, Iterable, List, Optional, Sequence
+
+import numpy as np
+
+from src.pipeline.header_model import MARKUP_STRUCK_RE, MARKUP_UNCLEAR_RE
+
+MODEL_PATH = Path(__file__).resolve().parents[2] / "configs" / "segmenter" / "content_model.json"
+SITUATIONS = ("next", "later", "back", "answered", "repeat")
+FOLDS = 5
+_TOKEN_RE = re.compile(r"[a-z]+|[0-9]+|[^\sa-z0-9]")
+
+
+def tokens(text: str) -> List[str]:
+    """Tokens of answer text read without crossed-out words."""
+    s = MARKUP_UNCLEAR_RE.sub(lambda m: m.group(1), MARKUP_STRUCK_RE.sub(" ", text or ""))
+    return _TOKEN_RE.findall(s.lower())
+
+
+def situation(header_q: str, current: Optional[str], answered: Iterable[str], order: Sequence[str]) -> str:
+    """The situation of a header naming `header_q` while `current` is being answered (see the module docstring)."""
+    order = list(order)
+    if current is not None and current == header_q:
+        return "repeat"
+    if header_q in set(answered) - {current}:
+        return "answered"
+    if current not in order or header_q not in order:
+        return "next"
+    step = order.index(header_q) - order.index(current)
+    return "next" if step == 1 else "later" if step > 1 else "back"
+
+
+class _Counts:
+    def __init__(self, counts: Dict[str, Dict[str, Dict[str, int]]]):
+        self.counts = counts  # paper -> question -> token -> count
+        self.totals = {p: {q: sum(c.values()) for q, c in qs.items()} for p, qs in counts.items()}
+        self.vocab = {p: len({t for c in qs.values() for t in c}) for p, qs in counts.items()}
+
+    @classmethod
+    def build(cls, answers: Iterable[dict]) -> "_Counts":
+        counts: Dict[str, Dict[str, Dict[str, int]]] = {}
+        for a in answers:
+            c = counts.setdefault(a["paper"], {}).setdefault(a["q"], {})
+            for t in a["tokens"]:
+                c[t] = c.get(t, 0) + 1
+        return cls(counts)
+
+    def loglik(self, paper: str, toks: Sequence[str], order: Sequence[str]) -> np.ndarray:
+        qs, v = self.counts.get(paper, {}), self.vocab.get(paper, 0)
+        out = []
+        for q in order:
+            c, denom = qs.get(q, {}), self.totals.get(paper, {}).get(q, 0) + v + 1
+            out.append(sum(math.log((c.get(t, 0) + 1) / denom) for t in toks))
+        return np.array(out)
+
+
+def _softmax(z: np.ndarray) -> np.ndarray:
+    z = z - z.max(axis=-1, keepdims=True)
+    e = np.exp(z)
+    return e / e.sum(axis=-1, keepdims=True)
+
+
+def _header_terms(p_header: np.ndarray, lam: float, eps: np.ndarray, k: np.ndarray):
+    """P(the header names its question and the header is right / wrong | content), for every header section."""
+    c_header = (1 - lam) * p_header + lam / k
+    return (1 - eps) * c_header, eps / (k - 1) * (1 - c_header)
+
+
+def _fit_rates(p_header: np.ndarray, k: np.ndarray, sit: np.ndarray, start=None, iterations: int = 300):
+    """Expectation-maximisation for lam (content that says nothing) and eps per situation (wrong headers)."""
+    lam, eps = start if start is not None else (0.05, {s: 0.05 for s in SITUATIONS})
+    for _ in range(iterations):
+        e = np.array([eps.get(x, 0.05) for x in sit])
+        right, wrong = _header_terms(p_header, lam, e, k)
+        total = right + wrong
+        new_lam = float(np.clip((lam / k / total).mean(), 1e-6, 1 - 1e-6))
+        new_eps = {s: float(np.clip((wrong / total)[sit == s].mean(), 1e-6, 1 - 1e-6)) if (sit == s).any() else 0.05
+                   for s in SITUATIONS}
+        done = abs(new_lam - lam) < 1e-8 and all(abs(new_eps[s] - eps[s]) < 1e-8 for s in SITUATIONS)
+        lam, eps = new_lam, new_eps
+        if done:
+            break
+    e = np.array([eps[x] for x in sit])
+    right, wrong = _header_terms(p_header, lam, e, k)
+    return lam, eps, -float(np.log(right + wrong).sum())
+
+
+def _golden(f, lo: float, hi: float, iterations: int = 60) -> float:
+    """Minimum of a unimodal function on [lo, hi]."""
+    g = (math.sqrt(5) - 1) / 2
+    a, b = lo, hi
+    c, d = b - g * (b - a), a + g * (b - a)
+    fc, fd = f(c), f(d)
+    for _ in range(iterations):
+        if fc < fd:
+            b, d, fd = d, c, fc
+            c = b - g * (b - a)
+            fc = f(c)
+        else:
+            a, c, fc = c, d, fd
+            d = a + g * (b - a)
+            fd = f(d)
+    return (a + b) / 2
+
+
+class ContentModel:
+    def __init__(self, counts: _Counts, beta: float, gamma: float, lam: float, eps: Dict[str, float]):
+        self.counts, self.beta, self.gamma, self.lam, self.eps = counts, beta, gamma, lam, eps
+
+    @classmethod
+    def train(cls, answers: List[dict], headers: List[dict], folds: int = FOLDS) -> "ContentModel":
+        """
+        `answers`: {script, paper, q, tokens} for every answer filed under a written header (the counts);
+        `headers`: {script, paper, q, tokens, situation, order} for every header section (the calibration).
+        """
+        scripts = sorted({a["script"] for a in answers} | {h["script"] for h in headers})
+        fold_of = {s: i % folds for i, s in enumerate(scripts)}
+        ll, n, label, k, sit = [], [], [], [], []
+        for f in range(folds):
+            counts = _Counts.build(a for a in answers if fold_of[a["script"]] != f)
+            for h in headers:
+                if fold_of[h["script"]] != f or not h["tokens"]:
+                    continue
+                vec = counts.loglik(h["paper"], h["tokens"], h["order"])
+                ll.append(vec)
+                n.append(len(h["tokens"]))
+                label.append(list(h["order"]).index(h["q"]))
+                k.append(len(h["order"]))
+                sit.append(h["situation"])
+        width = max(len(v) for v in ll)
+        lls = np.full((len(ll), width), -np.inf)
+        for i, v in enumerate(ll):
+            lls[i, :len(v)] = v
+        n, label, k, sit = np.array(n, float), np.array(label), np.array(k, float), np.array(sit)
+        rows = np.arange(len(label))
+
+        def p_header(beta: float, gamma: float) -> np.ndarray:
+            return _softmax(beta * (n ** (gamma - 1))[:, None] * lls)[rows, label]
+
+        rates = [None]  # the last fitted rates start the next fit
+
+        def nll(beta: float, gamma: float) -> float:
+            lam, eps, value = _fit_rates(p_header(beta, gamma), k, sit, rates[0])
+            rates[0] = (lam, eps)
+            return value
+
+        best = None
+        for gamma in np.linspace(0.0, 1.0, 11):
+            log_beta = _golden(lambda lb: nll(math.exp(lb), gamma), -8.0, 2.0, iterations=30)
+            value = nll(math.exp(log_beta), gamma)
+            if best is None or value < best[0]:
+                best = (value, math.exp(log_beta), float(gamma))
+        _, beta, gamma = best
+        lam, eps, _ = _fit_rates(p_header(beta, gamma), k, sit)
+        return cls(_Counts.build(answers), beta, gamma, lam, eps)
+
+    @classmethod
+    def load(cls, path: Path = MODEL_PATH) -> "ContentModel":
+        data = json.loads(Path(path).read_text(encoding="utf-8"))
+        return cls(_Counts(data["counts"]), data["beta"], data["gamma"], data["lam"], data["eps"])
+
+    def save(self, path: Path = MODEL_PATH) -> None:
+        Path(path).parent.mkdir(parents=True, exist_ok=True)
+        Path(path).write_text(json.dumps({"beta": self.beta, "gamma": self.gamma, "lam": self.lam, "eps": self.eps,
+                                          "counts": self.counts.counts}), encoding="utf-8")
+
+    def knows(self, paper: str) -> bool:
+        return paper in self.counts.counts
+
+    def posterior(self, paper: str, toks: Sequence[str], order: Sequence[str]) -> Dict[str, float]:
+        """P(q | content) over the paper's questions."""
+        if not toks:
+            return {q: 1.0 / len(order) for q in order}
+        z = self.beta * len(toks) ** (self.gamma - 1) * self.counts.loglik(paper, toks, order)
+        return dict(zip(order, _softmax(z).tolist()))
+
+    def header_posterior(self, paper: str, toks: Sequence[str], order: Sequence[str], header_q: str,
+                         where: str) -> Dict[str, float]:
+        """P(q | header naming header_q in situation `where`, content), over the paper's questions."""
+        post = self.posterior(paper, toks, order)
+        eps, k = self.eps[where], len(order)
+        joint = {q: ((1 - eps) if q == header_q else eps / (k - 1)) * ((1 - self.lam) * post[q] + self.lam / k)
+                 for q in order}
+        z = sum(joint.values())
+        return {q: v / z for q, v in joint.items()}
+
+
+_MODEL: Optional[ContentModel] = None
+_MODEL_LOADED = False
+
+
+def get_model() -> Optional[ContentModel]:
+    """The trained model, or None when configs/segmenter/content_model.json does not exist."""
+    global _MODEL, _MODEL_LOADED
+    if not _MODEL_LOADED:
+        _MODEL = ContentModel.load() if MODEL_PATH.exists() else None
+        _MODEL_LOADED = True
+    return _MODEL
+
+
+def set_model(model: Optional[ContentModel]) -> None:
+    """Use this model instead of the stored one (evaluation with held-out folds); None turns it off."""
+    global _MODEL, _MODEL_LOADED
+    _MODEL, _MODEL_LOADED = model, True
