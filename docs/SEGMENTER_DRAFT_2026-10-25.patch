+"""
+Learned question-header reader.
+
+Students write question headers in more forms than any list of patterns covers ("A: to the question No.5",
+"Ans tothequsstion no:5", "2NOQ/A:", a header after the last sentence of the previous answer). This reader learns what
+header lines look like from the transcripts themselves, with the segmenter's header grammar as the teacher: every line
+that contains a number that is a question on the paper is an example, labelled a header when the grammar reads it as a
+header for that number and answer text otherwise. It has two parts:
+
+  1. Shape: a multinomial naive Bayes model with add-one smoothing over the character 2- to 4-grams of the lowercased
+     line read without transcription markup (the number replaced by a placeholder, so it learns the shape of the line,
+     not the number), the line length in powers of two and where the number sits (start, middle, end). A line is read
+     three ways: all answer text, all header, or answer text followed by a header that starts at a word; the score is
+     the log-odds of the best header reading against the answer-text reading.
+  2. Place: naive Bayes counts every overlapping n-gram as separate evidence, so its scores are far too confident and
+     drown everything else. A logistic regression turns the score into a probability, together with how the number
+     follows the question being answered before the line (the same question, the next one on the paper, one further
+     on, an earlier one, none yet), what comes before the line (the page start, a blank line, text) and whether the
+     header follows answer text on the same line. It is fitted on scores of lines the shape model did not see (5 folds
+     by script), so it learns how far a score can be trusted.
+
+A line is a header when the probability is above one half. The model only adds headers: the segmenter asks it about
+lines its grammar does not read as a header, and the lines the grammar misses are exactly those that look like the
+grammar's headers in shape and place but were written in a form it does not know.
+Train it with scripts/train_header_model.py; the model is stored in configs/segmenter/header_model.json.
+"""
+
+import json
+import math
+import re
+from pathlib import Path
+from typing import Dict, Iterable, List, Optional, Sequence, Tuple
+
+import numpy as np
+
+MODEL_PATH = Path(__file__).resolve().parents[2] / "configs" / "segmenter" / "header_model.json"
+NGRAM_SIZES = (2, 3, 4)
+PLACEHOLDER = "§"
+READINGS = ("body", "header", "split")
+PLACE_FEATURES = ("follows:first", "follows:same", "follows:next", "follows:later", "follows:earlier",
+                  "after:page_start", "after:blank", "after:text", "reading:split")
+WEIGHT_NAMES = ("bias", "shape_score") + PLACE_FEATURES
+FOLDS = 5
+
+MARKUP_STRUCK_RE = re.compile(r'(?:\[struck:|struck\[:)\s*(?:\[[^\]]*\]|[^\]\[])*\]|~~[^~\n]*~~', re.IGNORECASE)
+MARKUP_UNCLEAR_RE = re.compile(r'\[unclear:\s*([^\]]*)\]', re.IGNORECASE)
+_NUMBER_RE = re.compile(r'(?<![0-9])([0-9]{1,2})(?![0-9])')
+_WORD_START_RE = re.compile(r'(?<=\s)\S')
+
+
+def unwrap_header_markup(line: str) -> str:
+    """
+    A line as the student wrote it, for reading a header: '[unclear: X]' becomes X, and a struck span without digits
+    is cancelled (inside a word it joins the two halves: 'ques[struck: nen]tion'). Struck digits stay: they can name a
+    corrected question number (see struck-number recovery). Circled digits stay too: students use them to number
+    items inside an answer ('⑥ Ans: Rosamond ...').
+    """
+    s = MARKUP_UNCLEAR_RE.sub(lambda m: m.group(1).strip(), line)
+
+    def _cancel(m: "re.Match") -> str:
+        if re.search(r'[0-9]', m.group(0)):
+            return m.group(0)
+        before, after = m.string[m.start() - 1:m.start()], m.string[m.end():m.end() + 1]
+        return "" if before.isalnum() and after.isalnum() else " "
+
+    return MARKUP_STRUCK_RE.sub(_cancel, s)
+
+
+def _grams(s: str) -> List[str]:
+    padded = f"^{s}$"
+    return [padded[i:i + n] for n in NGRAM_SIZES for i in range(len(padded) - n + 1)]
+
+
+def features(line: str, span: Optional[Tuple[int, int]] = None) -> List[str]:
+    """Shape features of a line; `span` is the question number's position (None: a piece read as answer text)."""
+    if span is not None:
+        line = line[:span[0]] + PLACEHOLDER + line[span[1]:]
+    s = re.sub(r"\s+", " ", re.sub(r"[0-9]", "0", unwrap_header_markup(line).lower())).strip()
+    feats = _grams(s) + [f"<words:{min(len(s.split()).bit_length(), 6)}>"]
+    if span is not None:
+        before, _, after = s.partition(PLACEHOLDER)
+        where = "start" if not re.search(r"[a-z0-9]", before) else "end" if not re.search(r"[a-z0-9]", after) else "mid"
+        feats.append(f"<number:{where}>")
+    return feats
+
+
+def place(q: str, previous: Optional[str], order: Sequence[str], prev_line: Optional[str]) -> List[str]:
+    """Where a number stands: after which question (`previous`, the one being answered) and after what line."""
+    order = list(order)
+    if previous not in order:
+        follows = "first"
+    else:
+        step = order.index(q) - order.index(previous)
+        follows = "same" if step == 0 else "next" if step == 1 else "later" if step > 1 else "earlier"
+    before = "page_start" if prev_line is None else "blank" if not prev_line.strip() else "text"
+    return [f"follows:{follows}", f"after:{before}"]
+
+
+def question_numbers(line: str, valid: Iterable[str]) -> List[Tuple[str, Tuple[int, int]]]:
+    """Numbers in the line that are questions on the paper and are not crossed out: [(question, span)]."""
+    valid = set(valid)
+    struck = [m.span() for m in MARKUP_STRUCK_RE.finditer(line)]
+    out = []
+    for m in _NUMBER_RE.finditer(line):
+        q = str(int(m.group(1)))
+        if q in valid and not any(a <= m.start() < b for a, b in struck):
+            out.append((q, m.span()))
+    return out
+
+
+def header_starts(line: str, end: int) -> List[int]:
+    """Where a header that ends at `end` can start after answer text: at a word, outside transcription markup."""
+    markup = [m.span() for r in (MARKUP_STRUCK_RE, MARKUP_UNCLEAR_RE) for m in r.finditer(line)]
+    return [m.start() for m in _WORD_START_RE.finditer(line[:end])
+            if not any(a < m.start() < b for a, b in markup)]
+
+
+class ShapeModel:
+    """Part 1: naive Bayes over the shape features."""
+
+    def __init__(self, counts: Dict[str, Dict[str, int]], readings: Dict[str, int]):
+        self.counts = counts
+        self.readings = readings
+        self.totals = {c: sum(v.values()) for c, v in counts.items()}
+        self.vocab = len(set(counts["header"]) | set(counts["body"]))
+        n = sum(readings[r] + 1 for r in READINGS)
+        self.log_prior = {r: math.log((readings[r] + 1) / n) for r in READINGS}
+
+    @classmethod
+    def train(cls, examples: Iterable[dict]) -> "ShapeModel":
+        counts: Dict[str, Dict[str, int]] = {"header": {}, "body": {}}
+        readings = {r: 0 for r in READINGS}
+        for ex in examples:
+            readings[ex["label"]] += 1
+            line, span, i = ex["line"], ex["span"], ex.get("split_at")
+            if ex["label"] == "split":
+                pieces = [(features(line[:i]), "body"), (features(line[i:], (span[0] - i, span[1] - i)), "header")]
+            else:
+                pieces = [(features(line, span), ex["label"])]
+            for feats, c in pieces:
+                for f in feats:
+                    counts[c][f] = counts[c].get(f, 0) + 1
+        return cls(counts, readings)
+
+    def loglik(self, feats: Sequence[str], c: str) -> float:
+        counts, denom = self.counts[c], self.totals[c] + self.vocab
+        return sum(math.log((counts.get(f, 0) + 1) / denom) for f in feats)
+
+    def score(self, line: str, span: Tuple[int, int]) -> Tuple[float, int]:
+        """(log-odds of the best header reading against the answer-text reading, where that header starts)."""
+        feats = features(line, span)
+        as_body = self.log_prior["body"] + self.loglik(feats, "body")
+        readings = [(self.log_prior["header"] + self.loglik(feats, "header"), 0)]
+        starts = header_starts(line, span[0])
+        for i in starts:
+            readings.append((
+                self.log_prior["split"] - math.log(len(starts))
+                + self.loglik(features(line[:i]), "body")
+                + self.loglik(features(line[i:], (span[0] - i, span[1] - i)), "header"),
+                i,
+            ))
+        best, start = max(readings)
+        return best - as_body, start
+
+
+def _design(score: float, place_feats: Sequence[str]) -> List[float]:
+    return [1.0, score] + [1.0 if f in place_feats else 0.0 for f in PLACE_FEATURES]
+
+
+def _fit_logistic(x: np.ndarray, y: np.ndarray, iterations: int = 50) -> np.ndarray:
+    """Maximum-likelihood logistic regression by Newton's method (a vanishing ridge keeps the steps defined)."""
+    w = np.zeros(x.shape[1])
+    for _ in range(iterations):
+        p = 1.0 / (1.0 + np.exp(-np.clip(x @ w, -50, 50)))
+        hessian = (x * (p * (1 - p))[:, None]).T @ x + 1e-6 * np.eye(x.shape[1])
+        step = np.linalg.solve(hessian, x.T @ (y - p))
+        w += step
+        if np.max(np.abs(step)) < 1e-8:
+            break
+    return w
+
+
+class HeaderModel:
+    def __init__(self, shape: ShapeModel, weights: Sequence[float]):
+        self.shape = shape
+        self.weights = np.asarray(weights, dtype=float)
+
+    @classmethod
+    def train(cls, per_script: Dict[str, List[dict]], folds: int = FOLDS) -> "HeaderModel":
+        """`per_script`: examples of each training script (see scripts/train_header_model.py)."""
+        scripts = sorted(per_script)
+        rows, labels = [], []
+        for k in range(folds):
+            held = [s for i, s in enumerate(scripts) if i % folds == k]
+            shape = ShapeModel.train(e for i, s in enumerate(scripts) if i % folds != k for e in per_script[s])
+            for s in held:
+                for ex in per_script[s]:
+                    score, start = shape.score(ex["line"], ex["span"])
+                    rows.append(_design(score, ex["place"] if not start else [ex["place"][0], "after:text", "reading:split"]))
+                    labels.append(1.0 if ex["label"] != "body" else 0.0)
+        weights = _fit_logistic(np.array(rows), np.array(labels))
+        return cls(ShapeModel.train(e for s in scripts for e in per_script[s]), weights)
+
+    @classmethod
+    def load(cls, path: Path = MODEL_PATH) -> "HeaderModel":
+        data = json.loads(Path(path).read_text(encoding="utf-8"))
+        return cls(ShapeModel(data["counts"], data["readings"]), [data["weights"][k] for k in WEIGHT_NAMES])
+
+    def save(self, path: Path = MODEL_PATH) -> None:
+        Path(path).parent.mkdir(parents=True, exist_ok=True)
+        Path(path).write_text(json.dumps({
+            "weights": dict(zip(WEIGHT_NAMES, self.weights.tolist())),
+            "readings": self.shape.readings, "counts": self.shape.counts,
+        }), encoding="utf-8")
+
+    def logit(self, score: float, place_feats: Sequence[str]) -> float:
+        return float(np.dot(self.weights, _design(score, place_feats)))
+
+    def read(self, line: str, order: Sequence[str], previous: Optional[str] = None,
+             prev_line: Optional[str] = None) -> Optional[Tuple[str, int, Tuple[int, int], float]]:
+        """
+        The most probable header reading of a line: (question, where the header starts, the number's span, log-odds
+        that it is a header), or None when every number in it more probably belongs to answer text.
+        `previous` is the question being answered before the line, `prev_line` the line before it on the page.
+        """
+        best = None
+        for q, span in question_numbers(line, order):
+            score, start = self.shape.score(line, span)
+            where = place(q, previous, order, prev_line) if not start else \
+                place(q, previous, order, line[:start])[:1] + ["after:text", "reading:split"]
+            odds = self.logit(score, where)
+            if odds > 0 and (best is None or odds > best[3]):
+                best = (q, start, span, odds)
+        return best
+
+
+_MODEL: Optional[HeaderModel] = None
+_MODEL_LOADED = False
+
+
+def get_model() -> Optional[HeaderModel]:
+    """The trained model, or None when configs/segmenter/header_model.json does not exist."""
+    global _MODEL, _MODEL_LOADED
+    if not _MODEL_LOADED:
+        _MODEL = HeaderModel.load() if MODEL_PATH.exists() else None
+        _MODEL_LOADED = True
+    return _MODEL
+
+
+def set_model(model: Optional[HeaderModel]) -> None:
+    """Use this model instead of the stored one (evaluation with held-out folds); None turns the reader off."""
+    global _MODEL, _MODEL_LOADED
+    _MODEL, _MODEL_LOADED = model, True
