+"""
+Train the learned content model (src/pipeline/content_model.py) on the dev-split transcripts.
+
+The segmenter's reading-order pass, with its header grammar only (no learned header reader, no content model), files
+the Opus, pipeline and Gemini transcripts of classes 6, 7, 8 and 10. Every section that opens with a written header
+for a question on the paper gives a calibration example: its content (header lines removed), the question the header
+names and the header's situation. The section and the sections filed after it as its continuation are one answer
+for the token counts, when the segmenter filed it under the question its header names. Test-split scripts
+(configs/splits/eval_split.csv) and the class-10 transcription test scripts 0029-0033 are never used.
+
+    python scripts/train_content_model.py            # writes configs/segmenter/content_model.json
+"""
+import contextlib
+import csv
+import io
+import sys
+from pathlib import Path
+from typing import Dict, List, Tuple
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from src.pipeline import content_model, header_model
+from src.pipeline.answer_segmenter import (
+    QuestionContext, _assign_sections, _base_q, _classify_header_raw, _content_tokens, _paper_catalog,
+)
+from src.pipeline.content_model import MODEL_PATH, ContentModel, situation
+from src.utils.question_utils import load_question_for_script
+from train_header_model import PAPERS, SKIP, page_texts, texts_of_paper
+
+EXPLICIT = ("explicit", "bengali", "subpart")
+
+
+def script_examples(sid: str, texts: List[str], q_obj, order: List[str]) -> Tuple[List[dict], List[dict]]:
+    """(answers, header sections) of one transcript of a script."""
+    ctx = QuestionContext(q_obj, order)
+    items = [(i, t) for i, t in enumerate(texts) if t]
+    with contextlib.redirect_stdout(io.StringIO()):
+        parts = _assign_sections(items, ctx, [])
+    paper = q_obj.question_id
+    answers, headers = [], []
+    current, answered = None, set()
+    for i, part in enumerate(parts):
+        named, source = _classify_header_raw(part.text, current_parent=current, question_obj=q_obj,
+                                             valid_q_order=order, completed_qs=answered)
+        hq = _base_q(named)
+        if source in EXPLICIT and hq in order:
+            toks = _content_tokens(part.text, order)
+            headers.append({"script": sid, "paper": paper, "q": hq, "tokens": toks, "order": order,
+                            "situation": situation(hq, current, answered, order)})
+            if _base_q(part.q) == hq:
+                j = i + 1
+                while j < len(parts) and parts[j].q == part.q and parts[j].source == "continuation":
+                    toks = toks + _content_tokens(parts[j].text, order)
+                    j += 1
+                answers.append({"script": sid, "paper": paper, "q": hq, "tokens": toks})
+        current = _base_q(part.q) or None
+        answered.add(current)
+    return answers, headers
+
+
+def collect(split: str = "dev") -> Dict[str, Tuple[List[dict], List[dict]]]:
+    """(answers, header sections) per script of the split, all three texts together."""
+    splits = {r["script_id"]: r["split"] for r in csv.DictReader(open(ROOT / "configs/splits/eval_split.csv"))}
+    header_model.set_model(None)
+    content_model.set_model(None)
+    per_script: Dict[str, Tuple[List[dict], List[dict]]] = {}
+    try:
+        for paper in PAPERS:
+            q_obj = load_question_for_script(paper, lang="english")
+            order, _, _ = _paper_catalog(q_obj)
+            for _src, sid, ext in texts_of_paper(paper):
+                if sid in SKIP or splits.get(sid) != split:
+                    continue
+                a, h = script_examples(sid, page_texts(ext), q_obj, order)
+                got = per_script.setdefault(sid, ([], []))
+                got[0].extend(a)
+                got[1].extend(h)
+    finally:
+        # the stored models are read again when they are next asked for
+        header_model._MODEL_LOADED = content_model._MODEL_LOADED = False
+    return per_script
+
+
+def train(per_script: Dict[str, Tuple[List[dict], List[dict]]]) -> ContentModel:
+    return ContentModel.train([a for a, _ in per_script.values() for a in a],
+                              [h for _, hs in per_script.values() for h in hs])
+
+
+if __name__ == "__main__":
+    per_script = collect("dev")
+    model = train(per_script)
+    model.save()
+    n_answers = sum(len(a) for a, _ in per_script.values())
+    n_headers = sum(len(h) for _, h in per_script.values())
+    print(f"{len(per_script)} dev scripts, {n_answers} answers, {n_headers} header sections; "
+          f"beta {model.beta:.4f}, gamma {model.gamma:.2f}, lam {model.lam:.4f}, eps " +
+          ", ".join(f"{s} {e:.4f}" for s, e in model.eps.items()) + f"; written to {MODEL_PATH.relative_to(ROOT)}")
