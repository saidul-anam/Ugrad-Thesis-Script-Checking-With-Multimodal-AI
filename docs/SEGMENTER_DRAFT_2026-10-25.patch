+"""
+Train the learned header reader (src/pipeline/header_model.py) on the dev-split transcripts.
+
+Every line that contains a number that is a question on its paper is an example. Its label comes from the
+segmenter's header grammar: a line the grammar reads as a header for that number is a header (a header after answer
+text on the same line gives a text piece and a header piece), any other line is answer text, and a line the grammar
+reads as a header for another number is left out. The question being answered when a page starts is the one the
+segmenter's reading-order pass (without the learned reader) files the end of the previous page under. The texts are the Opus transcripts, the pipeline transcripts and the
+Gemini transcripts of classes 6, 7, 8 and 10. Test-split scripts (configs/splits/eval_split.csv) and the class-10
+transcription test scripts 0029-0033 are never used.
+
+    python scripts/train_header_model.py            # writes configs/segmenter/header_model.json
+"""
+import contextlib
+import csv
+import io
+import json
+import sys
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from src.core.schemas import ExtractionResult
+from src.pipeline.answer_segmenter import (
+    QuestionContext, _assign_sections, _base_q, _explicit_header_of_line, _paper_catalog, _reads_as_header,
+    normalize_header_text,
+)
+from src.pipeline.header_model import MODEL_PATH, HeaderModel, place, question_numbers, set_model
+from src.utils.question_utils import load_question_for_script
+
+PAPERS = ["SE_06_Q1", "SE_07_Q1", "SE_08_Q1", "SE_10_Q1"]
+# SE_06_Q1_0004 is a 2nd Paper scan, SE_07_Q1_0000 has no text, SE_10_Q1_0029-0033 are the transcription test
+SKIP = {"SE_06_Q1_0004", "SE_07_Q1_0000", "SE_10_Q1"} | {f"SE_10_Q1_00{n}" for n in range(29, 34)}
+
+
+def line_examples(page_text: str, order: List[str], previous: Optional[str]) -> Tuple[List[dict], Optional[str]]:
+    """Examples of a page's lines; `previous` is the question being answered when the page starts."""
+    out = []
+    prev_line: Optional[str] = None
+    for line in page_text.split("\n"):
+        named = _base_q(_explicit_header_of_line(line, order))
+        for q, span in question_numbers(line, order):
+            ex = {"line": line, "span": span, "place": place(q, previous, order, prev_line)}
+            if not named:
+                out.append({**ex, "label": "body"})
+            elif named == q:
+                before = normalize_header_text(line).split("\n")[0]
+                if not before.strip() or _reads_as_header(before):
+                    out.append({**ex, "label": "header"})
+                elif line.startswith(before) and span[0] >= len(before):
+                    out.append({**ex, "label": "split", "split_at": len(before)})
+        prev_line = line
+        if named in order:
+            previous = named
+    return out, previous
+
+
+def page_texts(extraction: ExtractionResult) -> List[str]:
+    return [(p.stage2_verification.verified_transcript or p.stage1_transcription.raw_transcript or "").strip()
+            for p in extraction.pages or []]
+
+
+def answered_at_page_start(texts: List[str], ctx: QuestionContext) -> List[Optional[str]]:
+    """The question the reading-order pass (without the learned reader) is filing under when each page starts."""
+    items = [(i, t) for i, t in enumerate(texts) if t]
+    with contextlib.redirect_stdout(io.StringIO()):
+        parts = _assign_sections(items, ctx, [])
+    out, current = [], None
+    for i in range(len(texts)):
+        out.append(current)
+        for part in parts:
+            if part.page == i:
+                current = _base_q(part.q) or None
+    return out
+
+
+def texts_of_paper(paper: str):
+    """(source, script_id, extraction) for the Opus, pipeline and Gemini transcripts of a paper."""
+    from setup_data_without_pipeline import create_extraction_result_from_txt
+    for txt in sorted((ROOT / f"data/ground_truth/transcripts/{paper}_extraction_opus_5.5").glob("*.txt")):
+        with contextlib.redirect_stdout(io.StringIO()):
+            ext, _, _ = create_extraction_result_from_txt(txt.stem.upper(), txt.read_text(), paper, sync_gt=False)
+        yield "opus", txt.stem.upper(), ext
+    for src, root in (("pipe", "outputs/extracted/english"), ("gemini", "data_without_pipeline/english")):
+        for p in sorted((ROOT / root / paper.lower()).glob("*/extraction_result.json")):
+            yield src, p.parent.name, ExtractionResult.model_validate(json.loads(p.read_text()))
+
+
+def collect(split: str = "dev") -> Dict[str, List[dict]]:
+    """Examples per script of the split, all three texts together."""
+    splits = {r["script_id"]: r["split"] for r in csv.DictReader(open(ROOT / "configs/splits/eval_split.csv"))}
+    per_script: Dict[str, List[dict]] = {}
+    set_model(None)
+    for paper in PAPERS:
+        q_obj = load_question_for_script(paper, lang="english")
+        order, _, _ = _paper_catalog(q_obj)
+        ctx = QuestionContext(q_obj, order)
+        for _src, sid, ext in texts_of_paper(paper):
+            if sid in SKIP or splits.get(sid) != split:
+                continue
+            texts = page_texts(ext)
+            for text, previous in zip(texts, answered_at_page_start(texts, ctx)):
+                per_script.setdefault(sid, []).extend(line_examples(text, order, previous)[0])
+    return per_script
+
+
+if __name__ == "__main__":
+    per_script = collect("dev")
+    model = HeaderModel.train(per_script)
+    model.save()
+    print(f"{len(per_script)} dev scripts, {sum(map(len, per_script.values()))} lines {model.shape.readings}, "
+          f"{model.shape.vocab} shape features; written to {MODEL_PATH.relative_to(ROOT)}")
+    print("place weights:", json.loads(MODEL_PATH.read_text())["weights"])
